@page "/simulations/compare"
@rendermode InteractiveServer
@using ThermoCore.Api.Contracts
@using ThermoCore.Web.Services
@inject IThermoCoreApiClient Api

<PageTitle>Compare simulations — ThermoCore</PageTitle>

<h1>Compare simulations</h1>
<p>Compare summary metrics from in-memory jobs or persisted store records (DATA-008).</p>

<div class="mb-3">
    <div class="btn-group" role="group" aria-label="Compare source">
        <button type="button" class="btn @(source == CompareSource.Memory ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetSourceAsync(CompareSource.Memory)">In-memory</button>
        <button type="button" class="btn @(source == CompareSource.Persisted ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetSourceAsync(CompareSource.Persisted)">Persisted</button>
    </div>
</div>

@if (source == CompareSource.Memory && memoryJobs.Count == 0)
{
    <p class="text-muted">No simulations in memory yet. <a href="configurations">Configure and run</a> one first.</p>
}
else if (source == CompareSource.Persisted && persistedJobs.Count == 0)
{
    <p class="text-muted">No persisted summaries yet. Run a simulation (they are saved to the local store on completion).</p>
}
else
{
    <div class="row g-3 col-lg-10 mb-3">
        <div class="col-md-5">
            <label class="form-label">Simulation A</label>
            <select class="form-select" @bind="idA" @bind:after="RefreshAsync">
                <option value="">—</option>
                @if (source == CompareSource.Memory)
                {
                    @foreach (var job in completedMemoryJobs)
                    {
                        <option value="@job.SimulationId">@ShortId(job.SimulationId) (@job.Status)</option>
                    }
                }
                else
                {
                    @foreach (var job in persistedJobs)
                    {
                        <option value="@job.SummaryId">@ShortId(job.SummaryId) · @job.TopologyId</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label">Simulation B</label>
            <select class="form-select" @bind="idB" @bind:after="RefreshAsync">
                <option value="">—</option>
                @if (source == CompareSource.Memory)
                {
                    @foreach (var job in completedMemoryJobs)
                    {
                        <option value="@job.SimulationId">@ShortId(job.SimulationId) (@job.Status)</option>
                    }
                }
                else
                {
                    @foreach (var job in persistedJobs)
                    {
                        <option value="@job.SummaryId">@ShortId(job.SummaryId) · @job.TopologyId</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-outline-primary w-100" @onclick="LoadListsAsync">Refresh list</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (summaryA is not null && summaryB is not null)
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                <tr>
                    <th>Metric</th>
                    <th>A</th>
                    <th>B</th>
                    <th>Δ (B − A)</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>Succeeded</td>
                    <td>@BoolText(summaryA.Succeeded)</td>
                    <td>@BoolText(summaryB.Succeeded)</td>
                    <td>—</td>
                </tr>
                <tr>
                    <td>Topology</td>
                    <td>@summaryA.TopologyId</td>
                    <td>@summaryB.TopologyId</td>
                    <td>—</td>
                </tr>
                <tr>
                    <td>Completed steps</td>
                    <td>@summaryA.CompletedSteps</td>
                    <td>@summaryB.CompletedSteps</td>
                    <td>@(compare?.CompletedStepsDelta ?? summaryB.CompletedSteps - summaryA.CompletedSteps)</td>
                </tr>
                <tr>
                    <td>Water balance</td>
                    <td>@PassFail(summaryA.WaterBalancePassed)</td>
                    <td>@PassFail(summaryB.WaterBalancePassed)</td>
                    <td>—</td>
                </tr>
                <tr>
                    <td>Energy balance</td>
                    <td>@PassFail(summaryA.EnergyBalancePassed)</td>
                    <td>@PassFail(summaryB.EnergyBalancePassed)</td>
                    <td>—</td>
                </tr>
                <tr>
                    <td>Water residual (kg)</td>
                    <td>@summaryA.AggregatedWaterResidualKg.ToString("E3")</td>
                    <td>@summaryB.AggregatedWaterResidualKg.ToString("E3")</td>
                    <td>@((compare?.AggregatedWaterResidualKgDelta ?? summaryB.AggregatedWaterResidualKg - summaryA.AggregatedWaterResidualKg).ToString("E3"))</td>
                </tr>
                <tr>
                    <td>Energy residual (J)</td>
                    <td>@summaryA.AggregatedEnergyResidualJ.ToString("E3")</td>
                    <td>@summaryB.AggregatedEnergyResidualJ.ToString("E3")</td>
                    <td>@((compare?.AggregatedEnergyResidualJDelta ?? summaryB.AggregatedEnergyResidualJ - summaryA.AggregatedEnergyResidualJ).ToString("E3"))</td>
                </tr>
                <tr>
                    <td>Tank content (kg)</td>
                    <td>@(summaryA.FinalWaterTankContentKg?.ToString("F4") ?? "—")</td>
                    <td>@(summaryB.FinalWaterTankContentKg?.ToString("F4") ?? "—")</td>
                    <td>@(compare?.FinalWaterTankContentKgDelta?.ToString("F4") ?? DeltaOptional(summaryA.FinalWaterTankContentKg, summaryB.FinalWaterTankContentKg))</td>
                </tr>
                <tr>
                    <td>Warnings / errors</td>
                    <td>@summaryA.WarningCount / @summaryA.ErrorCount</td>
                    <td>@summaryB.WarningCount / @summaryB.ErrorCount</td>
                    <td>—</td>
                </tr>
                </tbody>
            </table>
        </div>
        <p class="text-muted">
            A: <code>@idA</code> · B: <code>@idB</code> · source: @source
        </p>
    }
}

@code {
    private enum CompareSource
    {
        Memory,
        Persisted
    }

    private CompareSource source = CompareSource.Memory;
    private IReadOnlyList<SimulationStatusResponse> memoryJobs = Array.Empty<SimulationStatusResponse>();
    private IReadOnlyList<PersistedSimulationListItem> persistedJobs = Array.Empty<PersistedSimulationListItem>();
    private string idA = string.Empty;
    private string idB = string.Empty;
    private SimulationSummaryResponse? summaryA;
    private SimulationSummaryResponse? summaryB;
    private SimulationCompareResponse? compare;
    private string? error;

    private IEnumerable<SimulationStatusResponse> completedMemoryJobs
        => memoryJobs.Where(j => j.Status is "Completed" or "Failed");

    protected override async Task OnInitializedAsync()
        => await LoadListsAsync();

    private async Task SetSourceAsync(CompareSource next)
    {
        source = next;
        idA = string.Empty;
        idB = string.Empty;
        summaryA = null;
        summaryB = null;
        compare = null;
        error = null;
        await LoadListsAsync();
    }

    private async Task LoadListsAsync()
    {
        error = null;
        memoryJobs = await Api.ListSimulationsAsync();
        persistedJobs = await Api.ListPersistedSimulationsAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        error = null;
        summaryA = null;
        summaryB = null;
        compare = null;

        if (string.IsNullOrWhiteSpace(idA) || string.IsNullOrWhiteSpace(idB))
        {
            return;
        }

        if (string.Equals(idA, idB, StringComparison.Ordinal))
        {
            error = "Select two different simulations.";
            return;
        }

        try
        {
            if (source == CompareSource.Memory)
            {
                summaryA = await Api.GetSummaryAsync(idA);
                summaryB = await Api.GetSummaryAsync(idB);
                if (summaryA is null || summaryB is null)
                {
                    error = "Summary is available only for completed or failed jobs.";
                    return;
                }

                compare = new SimulationCompareResponse
                {
                    A = summaryA,
                    B = summaryB,
                    CompletedStepsDelta = summaryB.CompletedSteps - summaryA.CompletedSteps,
                    AggregatedWaterResidualKgDelta = summaryB.AggregatedWaterResidualKg - summaryA.AggregatedWaterResidualKg,
                    AggregatedEnergyResidualJDelta = summaryB.AggregatedEnergyResidualJ - summaryA.AggregatedEnergyResidualJ,
                    FinalWaterTankContentKgDelta = summaryA.FinalWaterTankContentKg is { } ta && summaryB.FinalWaterTankContentKg is { } tb
                        ? tb - ta
                        : null
                };
            }
            else
            {
                compare = await Api.ComparePersistedAsync(idA, idB);
                if (compare is null)
                {
                    error = "One or both persisted summaries were not found.";
                    return;
                }

                summaryA = compare.A;
                summaryB = compare.B;
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private static string ShortId(string id)
        => id.Length <= 8 ? id : id[..8] + "…";

    private static string BoolText(bool value) => value ? "yes" : "no";

    private static string PassFail(bool value) => value ? "PASS" : "FAIL";

    private static string DeltaOptional(double? a, double? b)
    {
        if (a is null || b is null)
        {
            return "—";
        }

        return (b.Value - a.Value).ToString("F4");
    }
}
