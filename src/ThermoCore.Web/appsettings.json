{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiResourceLimits": {
    "MaximumDurationSeconds": 86400,
    "MinimumTimeStepSeconds": 0.1,
    "MaximumStepCount": 50000,
    "MaximumConcurrentJobs": 4
  }
}
