@page "/"

<PageTitle>ThermoCore</PageTitle>

<section class="hero-block">
    <p class="eyebrow">ThermoCore</p>
    <h1>Thermodynamic simulation for atmospheric water generation</h1>
    <p class="lede">
        Configure and run AWG reference simulations, inspect balances, and compute psychrometric states
        through the application API — physics stays in ThermoCore.Core.
    </p>
    <div class="cta-row">
        <a class="btn btn-primary" href="psychrometrics">Psychrometric calculator</a>
        <a class="btn btn-outline-secondary" href="configurations">Configure AWG</a>
        <a class="btn btn-outline-secondary" href="simulations/new">Quick run</a>
    </div>
</section>

<section class="info-block">
    <h2>Status</h2>
    <ul>
        <li>Core + AWG V3 MVP models</li>
        <li>API v1 jobs, summary, series, diagnostics, export</li>
        <li>DOC-022 regression scenarios via console <code>regress</code></li>
    </ul>
    <p class="disclaimer">
        Engineering software under active development. Results require engineering judgment and validation
        before design decisions.
    </p>
</section>

